# ============================================================
#  Поднебесная — переменные окружения для docker compose
#  Скопируйте файл в .env и смените пароли:
#    copy .env.example .env
# ============================================================

# Публичный адрес форума.
# Должен совпадать с адресом, по которому открывается сайт, плюс /forum.
# Если меняете PORT в server.js, задайте новый адрес до первого запуска форума.
FORUM_PUBLIC_URL=http://localhost:8000/forum

# --- MongoDB ---
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root-password
NODEBB_DB_NAME=nodebb
NODEBB_DB_USER=nodebb
NODEBB_DB_PASSWORD=change-me-nodebb-password

# --- Администратор NodeBB ---
NODEBB_ADMIN_USERNAME=admin
NODEBB_ADMIN_PASSWORD=change-me-strong-password
NODEBB_ADMIN_EMAIL=admin@example.com
